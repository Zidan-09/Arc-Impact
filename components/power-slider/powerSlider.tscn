[sub_resource type="GDScript" id="GDScript_777x3"]
script/source = "extends Control

@onready var normal: TextureRect = $Normal
@onready var pressed: TextureRect = $Pressed

var dragging := false


func _ready() -> void:
	update_visual()


func set_dragging(value: bool) -> void:
	dragging = value
	update_visual()


func update_visual() -> void:
	normal.visible = not dragging
	pressed.visible = dragging
"

